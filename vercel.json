{
  "buildCommand": "node tools/check-cards.js && node tools/validate-graphics.js && node answer-keys/build.js",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "^/study/(?:[^/]+/)*([^/]+\\.(?:js|css|png|svg|json|ico|webp))$",
      "dest": "/$1"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "query",
          "key": "code"
        }
      ],
      "dest": "/homepage.html"
    },
    {
      "src": "^/$",
      "dest": "/home.html"
    },
    {
      "src": "^/(?!mcat(?:/|$))[Mm][Cc][Aa][Tt](/.*)?$",
      "status": 301,
      "headers": {
        "Location": "/mcat$1"
      }
    },
    {
      "src": "^/why-it-works/?$",
      "status": 301,
      "headers": {
        "Location": "/how-it-works"
      }
    },
    {
      "src": "^/community/?$",
      "dest": "/community.html"
    },
    {
      "src": "^/free-trial/?$",
      "status": 301,
      "headers": {
        "Location": "/mcat/free"
      }
    },
    {
      "src": "^/mcat/?$",
      "dest": "/homepage.html"
    },
    {
      "src": "^/mcat/how-it-works/?$",
      "status": 301,
      "headers": {
        "Location": "/how-it-works"
      }
    },
    {
      "src": "^/mcat/community/?$",
      "status": 301,
      "headers": {
        "Location": "/community"
      }
    },
    {
      "src": "^/mcat/free-trial/?$",
      "status": 301,
      "headers": {
        "Location": "/mcat/free"
      }
    },
    {
      "src": "^/mcat/free/?$",
      "dest": "/free.html"
    },
    {
      "src": "^/login$",
      "dest": "/index.html"
    },
    {
      "src": "^/signup$",
      "dest": "/index.html"
    },
    {
      "src": "^/referral/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/(dashboard|raise-your-hand|bookmarks|notes|weaknesses|account|owner-dashboard|test-date|import-progress|graphics-preview|forgot-password|reset-password|check-email|verify-email)/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/study/(bio-biochem|chem-phys|psych-soc|cars|all-topics|weakest-topics|focused-review|my-cards)(/start|/missed-cards|/reinforcement(/start|/complete)?|/complete)?/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/how-it-works/?$",
      "dest": "/how-it-works.html"
    },
    {
      "src": "^/sample-cards/?$",
      "dest": "/sample-cards.html"
    },
    {
      "src": "^/about-us$",
      "dest": "/about-us.html"
    },
    {
      "src": "^/contact$",
      "dest": "/contact.html"
    },
    {
      "src": "^/about-rosalind$",
      "dest": "/about-rosalind.html"
    },
    {
      "src": "^/privacy-policy$",
      "dest": "/privacy-policy.html"
    },
    {
      "src": "^/terms-of-use$",
      "dest": "/terms-of-use.html"
    },
    {
      "handle": "filesystem"
    }
  ],
  "crons": [
    {
      "path": "/api/encourage",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/backup",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/community",
      "schedule": "0 17 * * *"
    }
  ],
  "functions": {
    "api/encourage.js": {
      "maxDuration": 60
    },
    "api/backup.js": {
      "maxDuration": 60
    },
    "api/community.js": {
      "maxDuration": 60
    }
  }
}
