{
  "buildCommand": "node tools/check-cards.js && node tools/validate-graphics.js && node answer-keys/build.js",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "^/study/(?:[^/]+/)*([^/]+\\.(?:js|css|png|svg|json|ico|webp))$",
      "dest": "/$1"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "query",
          "key": "code"
        }
      ],
      "dest": "/homepage.html"
    },
    {
      "src": "^/$",
      "status": 302,
      "headers": {
        "Location": "/mcat"
      }
    },
    {
      "src": "^/(?!mcat(?:/|$))[Mm][Cc][Aa][Tt](/.*)?$",
      "status": 301,
      "headers": {
        "Location": "/mcat$1"
      }
    },
    {
      "src": "^/why-it-works/?$",
      "status": 301,
      "headers": {
        "Location": "/mcat/how-it-works"
      }
    },
    {
      "src": "^/community/?$",
      "status": 301,
      "headers": {
        "Location": "/mcat/community"
      }
    },
    {
      "src": "^/free-trial/?$",
      "status": 301,
      "headers": {
        "Location": "/mcat/free-trial"
      }
    },
    {
      "src": "^/mcat/?$",
      "dest": "/homepage.html"
    },
    {
      "src": "^/mcat/how-it-works/?$",
      "dest": "/how-it-works.html"
    },
    {
      "src": "^/mcat/community/?$",
      "dest": "/community.html"
    },
    {
      "src": "^/mcat/free-trial/?$",
      "dest": "/free-trial.html"
    },
    {
      "src": "^/login$",
      "dest": "/index.html"
    },
    {
      "src": "^/signup$",
      "dest": "/index.html"
    },
    {
      "src": "^/(dashboard|bookmarks|notes|weaknesses|account|owner-dashboard|test-date|import-progress|graphics-preview|forgot-password|reset-password|check-email|verify-email)/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/study/(bio-biochem|chem-phys|psych-soc|cars|all-topics|weakest-topics|focused-review)(/start|/missed-cards|/reinforcement(/start|/complete)?|/complete)?/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/about-us$",
      "dest": "/about-us.html"
    },
    {
      "src": "^/contact$",
      "dest": "/contact.html"
    },
    {
      "src": "^/about-rosalind$",
      "dest": "/about-rosalind.html"
    },
    {
      "src": "^/privacy-policy$",
      "dest": "/privacy-policy.html"
    },
    {
      "src": "^/terms-of-use$",
      "dest": "/terms-of-use.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
