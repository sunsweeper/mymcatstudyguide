{
  "buildCommand": "node tools/check-cards.js && node tools/validate-graphics.js",
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/",
      "destination": "/homepage.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/signup",
      "destination": "/index.html"
    },
    {
      "source": "/why-it-works",
      "destination": "/why-it-works.html"
    },
    {
      "source": "/community",
      "destination": "/community.html"
    },
    {
      "source": "/free-trial",
      "destination": "/free-trial.html"
    },
    {
      "source": "/contact",
      "destination": "/contact.html"
    },
    {
      "source": "/privacy-policy",
      "destination": "/privacy-policy.html"
    },
    {
      "source": "/terms-of-use",
      "destination": "/terms-of-use.html"
    }
  ]
}
