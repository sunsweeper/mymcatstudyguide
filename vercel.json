{
  "buildCommand": "node tools/check-cards.js && node tools/validate-graphics.js",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "^/$",
      "dest": "/homepage.html"
    },
    {
      "src": "^/login$",
      "dest": "/index.html"
    },
    {
      "src": "^/signup$",
      "dest": "/index.html"
    },
    {
      "src": "^/why-it-works$",
      "dest": "/why-it-works.html"
    },
    {
      "src": "^/community$",
      "dest": "/community.html"
    },
    {
      "src": "^/free-trial$",
      "dest": "/free-trial.html"
    },
    {
      "src": "^/contact$",
      "dest": "/contact.html"
    },
    {
      "src": "^/privacy-policy$",
      "dest": "/privacy-policy.html"
    },
    {
      "src": "^/terms-of-use$",
      "dest": "/terms-of-use.html"
    },
    {
      "handle": "filesystem"
    }
  ]
}
